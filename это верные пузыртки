local function getAnchorPart(tool)
	if not tool then return nil end
	local handle = tool:FindFirstChild("Handle")
	if handle and handle:IsA("BasePart") then return handle end
	for _, desc in ipairs(tool:GetDescendants()) do
		if desc:IsA("BasePart") and not desc:FindFirstChild("Flame") then
			return desc
		end
	end
	return tool:FindFirstChildWhichIsA("BasePart", true)
end

local function getToolBodyParts(tool)
	local parts = {}
	if not tool then return parts end
	for _, desc in ipairs(tool:GetDescendants()) do
		if desc:IsA("BasePart") and not desc:FindFirstChild("Flame") then
			table.insert(parts, desc)
		end
	end
	return parts
end

local function savePartVisual(part)
	if not part or not part:IsA("BasePart") or partVisualOrig[part] then return end
	partVisualOrig[part] = {
		Transparency = part.Transparency,
	}
end

local function sanitizePartPhysics(part)
	if not part or not part:IsA("BasePart") then return end
	pcall(function()
		part.Anchored = false
		part.CanCollide = false
		part.CanTouch = false
		part.CanQuery = false
		part.Massless = true
		part.AssemblyLinearVelocity = Vector3.zero
		part.AssemblyAngularVelocity = Vector3.zero
	end)
end

local function stripPhysicsMovers(container)
	if not container then return end
	for _, desc in ipairs(container:GetDescendants()) do
		if desc:IsA("Script")
			or desc:IsA("LocalScript")
			or desc:IsA("BodyMover")
			or desc:IsA("Constraint")
			or desc:IsA("LinearVelocity")
			or desc:IsA("AngularVelocity")
			or desc:IsA("VectorForce")
			or desc:IsA("AlignPosition")
			or desc:IsA("AlignOrientation") then
			pcall(function() desc:Destroy() end)
		end
	end
end

local function update3DTransform(entry)
	if not entry or not entry.root or not entry.primary or not entry.anchor then return end
	if not entry.root.Parent or not entry.anchor.Parent then return end

	for part, baseSize in pairs(entry.baseSizes) do
		if part and part.Parent and part:IsA("BasePart") then
			pcall(function()
				part.Size = baseSize * modelScale
				sanitizePartPhysics(part)
			end)
		end
	end

	local targetCF = entry.anchor.CFrame * CFrame.new(modelOffsetPos)
	pcall(function()
		if entry.weld then
			entry.weld.Enabled = false
		end
		entry.primary.CFrame = targetCF
		for part, relCF in pairs(entry.baseOffsets) do
			if part and part.Parent and part ~= entry.primary and part:IsA("BasePart") then
				part.CFrame = targetCF * CFrame.new(relCF.Position * modelScale) * relCF.Rotation
			end
		end
		if entry.weld then
			entry.weld.Enabled = true
		end
	end)
end

local function refreshAll3DTransforms()
	for _, entry in ipairs(spawned3DModels) do
		update3DTransform(entry)
	end
end

local function clearCustom3D()
	customModelActive = false

	for i = #spawned3DModels, 1, -1 do
		local entry = spawned3DModels[i]
		table.remove(spawned3DModels, i)
		if entry then
			if entry.weld then pcall(function() entry.weld:Destroy() end) end
			if entry.root then pcall(function() entry.root:Destroy() end) end
		end
	end

	for part, orig in pairs(partVisualOrig) do
		if part and part.Parent then
			pcall(function()
				part.Transparency = orig.Transparency
			end)
		end
		partVisualOrig[part] = nil
	end
end

local function fetchCreatorStoreAsset(assetUri)
	local ok, objs = pcall(function()
		return game:GetObjects(assetUri)
	end)
	if ok and type(objs) == "table" and #objs > 0 then
		return objs
	end
	local ok2, loaded = pcall(function()
		return InsertService:LoadLocalAsset(assetUri)
	end)
	if ok2 and loaded then
		return { loaded }
	end
	return nil
end

local function extractTextureFromInstance(obj)
	if not obj then return nil end
	if obj:IsA("Decal") or obj:IsA("Texture") then
		if obj.Texture and obj.Texture ~= "" then
			return normalizeAssetId(obj.Texture) or obj.Texture
		end
	elseif obj:IsA("ImageLabel") or obj:IsA("ImageButton") then
		if obj.Image and obj.Image ~= "" then
			return normalizeAssetId(obj.Image) or obj.Image
		end
	elseif obj:IsA("ShirtGraphic") then
		if obj.Graphic and obj.Graphic ~= "" then
			return normalizeAssetId(obj.Graphic) or obj.Graphic
		end
	elseif obj:IsA("ParticleEmitter") then
		if obj.Texture and obj.Texture ~= "" then
			return normalizeAssetId(obj.Texture) or obj.Texture
		end
	elseif obj:IsA("MeshPart") then
		if obj.TextureID and obj.TextureID ~= "" then
			return normalizeAssetId(obj.TextureID) or obj.TextureID
		end
	elseif obj:IsA("SpecialMesh") then
		if obj.TextureId and obj.TextureId ~= "" then
			return normalizeAssetId(obj.TextureId) or obj.TextureId
		end
	end
	return nil
end

local function resolveTextureUri(assetUri)
	local objs = fetchCreatorStoreAsset(assetUri)
	local foundId = assetUri
	if objs then
		for _, root in ipairs(objs) do
			local candidates = { root }
			for _, desc in ipairs(root:GetDescendants()) do
				table.insert(candidates, desc)
			end
			for _, obj in ipairs(candidates) do
				local tex = extractTextureFromInstance(obj)
				if tex and tex ~= assetUri then
					foundId = tex
					break
				end
			end
			pcall(function() root:Destroy() end)
		end
	end
	return foundId
end

local function has3DContent(inst)
