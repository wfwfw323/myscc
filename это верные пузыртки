	if inst:IsA("BasePart") then return true end
	if inst:IsA("Model") or inst:IsA("Accessory") or inst:IsA("Tool") then
		return inst:FindFirstChildWhichIsA("BasePart", true) ~= nil
	end
	return false
end

local function prep3DInstance(inst, anchorPart)
	if not inst or not anchorPart then return nil end
	stripPhysicsMovers(inst)

	local wrapper = inst
	if inst:IsA("BasePart") then
		local m = Instance.new("Model")
		m.Name = "CreatorStore3DModel"
		inst.Parent = m
		m.PrimaryPart = inst
		wrapper = m
	elseif inst:IsA("Accessory") or inst:IsA("Tool") then
		local m = Instance.new("Model")
		m.Name = "CreatorStore3DModel"
		for _, child in ipairs(inst:GetChildren()) do
			child.Parent = m
		end
		local h = m:FindFirstChild("Handle") or m:FindFirstChildWhichIsA("BasePart", true)
		if h and h:IsA("BasePart") then m.PrimaryPart = h end
		pcall(function() inst:Destroy() end)
		wrapper = m
	elseif not inst:IsA("Model") then
		return nil
	end

	local primary = wrapper.PrimaryPart or wrapper:FindFirstChildWhichIsA("BasePart", true)
	if not primary then
		wrapper:Destroy()
		return nil
	end
	wrapper.PrimaryPart = primary

	local baseSizes = {}
	local baseOffsets = {}
	local primaryCF = primary.CFrame

	for _, desc in ipairs(wrapper:GetDescendants()) do
		if desc:IsA("BasePart") then
			sanitizePartPhysics(desc)
			baseSizes[desc] = desc.Size
			if desc ~= primary then
				baseOffsets[desc] = primaryCF:ToObjectSpace(desc.CFrame)
			end
		end
	end

	wrapper.Parent = anchorPart.Parent
	wrapper:PivotTo(anchorPart.CFrame * CFrame.new(modelOffsetPos))

	for _, desc in ipairs(wrapper:GetDescendants()) do
		if desc:IsA("BasePart") and desc ~= primary then
			local w = Instance.new("WeldConstraint")
			w.Part0 = primary
			w.Part1 = desc
			w.Parent = primary
		end
	end

	local rootWeld = Instance.new("WeldConstraint")
	rootWeld.Part0 = anchorPart
	rootWeld.Part1 = primary
	rootWeld.Parent = anchorPart

	for part in pairs(baseSizes) do
		part.ChildAdded:Connect(function(ch)
			if ch:IsA("BasePart") then sanitizePartPhysics(ch) end
		end)
		part:GetPropertyChangedSignal("CanCollide"):Connect(function()
			if part.CanCollide then part.CanCollide = false end
		end)
		part:GetPropertyChangedSignal("Massless"):Connect(function()
			if not part.Massless then part.Massless = true end
		end)
	end

	local entry = {
		root = wrapper,
		primary = primary,
		anchor = anchorPart,
		weld = rootWeld,
		baseSizes = baseSizes,
		baseOffsets = baseOffsets,
	}
	update3DTransform(entry)
	return entry
end

