local function getCharacterFromObj(obj)
	local cur = obj
	while cur do
		if cur:IsA("Model") then
			for _, plr in ipairs(Players:GetPlayers()) do
				if plr.Character and cur == plr.Character then
					return cur, plr
				end
			end
		end
		cur = cur.Parent
	end
	return nil, nil
end

local function isLocalPlayerCharacter(obj)
	local char = getCharacterFromObj(obj)
	return char ~= nil and char == player.Character
end

local function getAncestorTool(inst)
	local cur = inst
	while cur do
		if cur:IsA("Tool") then return cur end
		cur = cur.Parent
	end
	return nil
end

local function isMyTool(tool)
	if not tool or not tool:IsA("Tool") then return false end
	local parent = tool.Parent
	if not parent then return false end
	local myChar = player.Character
	local myBackpack = player:FindFirstChildOfClass("Backpack")
	return (myChar and parent == myChar) or (myBackpack and parent == myBackpack)
end

local function isMyEmitter(emitter)
	if not emitter or not emitter.Parent then return false end
	local tool = getAncestorTool(emitter)
	return tool ~= nil and isMyTool(tool)
end

local function isAnyToolDescendant(inst)
	return getAncestorTool(inst) ~= nil
end

local function isFlamethrowerContainer(inst)
	if not inst then return false end
	local n = string.lower(inst.Name)
	return string.find(n, "flamethrower", 1, true) ~= nil
		or string.find(n, "flame thrower", 1, true) ~= nil
end

local function getEquippedFlamethrowers()
	local equipped = {}
	local character = player.Character
	if not character then return equipped end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then
			local part = child:FindFirstChild("Part", true)
			if isFlamethrowerContainer(child)
				or (part and part:FindFirstChild("Flame") and part.Flame:IsA("ParticleEmitter")) then
				table.insert(equipped, child)
			end
		end
	end
	return equipped
end

local function getWeaponRoots()
	local roots, seen = {}, {}
	local function add(tool)
		if tool and tool:IsA("Tool") and not seen[tool] and isMyTool(tool) then
			seen[tool] = true
			table.insert(roots, tool)
		end
	end
	local character = player.Character
	local backpack  = player:FindFirstChildOfClass("Backpack")
	if character then
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") then
				local part = child:FindFirstChild("Part", true)
				if isFlamethrowerContainer(child)
					or (part and part:FindFirstChild("Flame") and part.Flame:IsA("ParticleEmitter")) then
					add(child)
				end
			end
		end
	end
	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") then
				local part = child:FindFirstChild("Part", true)
				if isFlamethrowerContainer(child) or (part and part:FindFirstChild("Flame", true)) then
					add(child)
				end
			end
		end
	end
	return roots
end

local function findEmitters()
	local found, seen = {}, {}
	for _, root in ipairs(getWeaponRoots()) do
		for _, obj in ipairs(root:GetDescendants()) do
			if obj:IsA("ParticleEmitter") and obj.Name == "Flame"
				and obj.Parent and obj.Parent:IsA("BasePart") and not seen[obj]
				and isMyEmitter(obj) then
				seen[obj] = true
				table.insert(found, obj)
			end
		end
	end
	return found
end

