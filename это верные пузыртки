		BorderSizePixel = 0
	}, panel)
	round(resetButton, 7)

	statusLabel = make("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(15, 682),
		Size = UDim2.new(1, -30, 0, 52),
		Font = Enum.Font.GothamMedium,
		Text = "Готово: чужой огонь остаётся дефолтным, GUI двигается, XYZ — ползунки.",
		TextSize = 11,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(135, 235, 170)
	}, panel)

	applyTextureButton.Activated:Connect(function()
		local rawId = extractAssetId(textureInputBox.Text)
		local normalized = normalizeAssetId(textureInputBox.Text)
		if normalized then
			selectedTexture = resolveTextureUri(normalized)
			local ok, msg = applyVisuals()
			setStatus(("ID %s -> %s"):format(rawId, msg), ok)
		else
			setStatus("Некорректная ссылка или ID текстуры.", false)
		end
	end)

	hexInputBox.FocusLost:Connect(function()
		local parsed = parseHex(hexInputBox.Text)
		if parsed then
			selectedColor = parsed
			colorPreview.BackgroundColor3 = parsed
			refreshPalette()
		end
	end)

	addColor.Activated:Connect(function()
		local parsed = parseHex(hexInputBox.Text) or selectedColor
		selectedColor = parsed
		colorPreview.BackgroundColor3 = parsed
		hexInputBox.Text = colorToHex(parsed)
		table.insert(palette, parsed)
		refreshPalette()
		setStatus("Цвет добавлен в палитру.", true)
	end)

	applyColor.Activated:Connect(function()
		local parsed = parseHex(hexInputBox.Text)
		if parsed then
			selectedColor = parsed
			colorPreview.BackgroundColor3 = parsed
		end
		local ok, msg = applyVisuals()
		setStatus(msg, ok)
		refreshPalette()
	end)

	local function updateWidth(delta)
		selectedWidth = math.clamp(math.floor((selectedWidth + delta) * 10 + 0.5) / 10, 0.5, 4.0)
		widthLabel.Text = ("x%.1f"):format(selectedWidth)
		if applyEnabled then
			local ok, msg = applyVisuals()
			setStatus(msg, ok)
		end
	end

	minus.Activated:Connect(function() updateWidth(-0.5) end)
	plus.Activated:Connect(function() updateWidth(0.5) end)

	local function updateScale(delta)
		modelScale = math.clamp(math.floor((modelScale + delta) * 10 + 0.5) / 10, 0.2, 5.0)
		scaleLabel.Text = ("Scale %.1fx"):format(modelScale)
		refreshAll3DTransforms()
		setStatus(("3D Scale: %.1fx"):format(modelScale), true)
	end

	scaleMinus.Activated:Connect(function() updateScale(-0.2) end)
	scalePlus.Activated:Connect(function() updateScale(0.2) end)

	applyModelBtn.Activated:Connect(function()
		local rawId = extractAssetId(modelIdInputBox.Text)
		local uri = normalizeAssetId(modelIdInputBox.Text)
		if not uri then
			setStatus("Вставь корректную ссылку Creator Store или ID.", false)
			return
		end
		syncPositionFromBoxes()
		selectedModelId = uri
		local ok, msg = apply3DModelFromStore(uri, false)
		setStatus(("ID %s: %s"):format(rawId, msg), ok)
	end)

	clearModelBtn.Activated:Connect(function()
		selectedModelId = ""
		clearCustom3D()
		setStatus("3D модель снята, огнемёт возвращён.", true)
	end)

	saveCfgBtn.Activated:Connect(function()
		syncPositionFromBoxes()
		local targetName = (configNameBox.Text ~= "" and configNameBox.Text) or selectedConfigName
		local ok, msg = saveConfigToDisk(targetName)
		setStatus(msg, ok)
	end)

	loadCfgBtn.Activated:Connect(function()
		local targetName = (configNameBox.Text ~= "" and configNameBox.Text) or selectedConfigName
		local ok, msg = loadConfigFromDisk(targetName)
		setStatus(msg, ok)
	end)

	delCfgBtn.Activated:Connect(function()
		local targetName = (selectedConfigName ~= "" and selectedConfigName) or configNameBox.Text
		local ok, msg = deleteConfigFromDisk(targetName)
		setStatus(msg, ok)
	end)

	applyAllButton.Activated:Connect(function()
		local parsed = parseHex(hexInputBox.Text)
		if parsed then
			selectedColor = parsed
			colorPreview.BackgroundColor3 = parsed
		end
		local normalized = normalizeAssetId(textureInputBox.Text)
		if normalized then
			selectedTexture = resolveTextureUri(normalized)
		end
		syncPositionFromBoxes()
		local ok, msg = applyVisuals()
		setStatus(msg, ok)
		refreshPalette()
	end)

	resetButton.Activated:Connect(function()
		local restored = restoreOriginal()
		selectedWidth = DEFAULT_WIDTH
		widthLabel.Text = "x1.0"
		scaleLabel.Text = "Scale 1.0x"
		if setSliderX then setSliderX(0, false) end
		if setSliderY then setSliderY(0, false) end
		if setSliderZ then setSliderZ(0, false) end
		colorPreview.BackgroundColor3 = selectedColor
		hexInputBox.Text = colorToHex(selectedColor)
		refreshPalette()
		setStatus(("Сброшено (%d)."):format(restored), true)
	end)

	refreshPalette()
	refreshConfigListUI()
end

bindAllPlayerCharacters()
createGui()
reapplyAfterRespawn()
