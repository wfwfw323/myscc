-- ============================================================
-- CREATOR STORE URL / ID PARSER
-- ============================================================
local function extractAssetId(value)
	local raw = tostring(value or "")
	if raw == "" then return nil end

	local pathId = raw:match("/store/asset/(%d+)")
		or raw:match("/catalog/(%d+)")
		or raw:match("/library/(%d+)")
		or raw:match("/bundles/(%d+)")
		or raw:match("[?&]assetId=(%d+)")
		or raw:match("[?&]id=(%d+)")
	if pathId then
		return pathId
	end

	local trimmed = raw:gsub("^%s+", ""):gsub("%s+$", "")
	local directId = trimmed:match("^rbxassetid://(%d+)$") or trimmed:match("^(%d+)$")
	if directId then
		return directId
	end

	return raw:match("(%d+)")
end

local function normalizeAssetId(value)
	local id = extractAssetId(value)
	return id and ("rbxassetid://" .. id) or nil
end

