local function scaleNumberSequence(seq, mult)
	if not seq or mult == 1 then return seq end
	local kps = {}
	for _, pt in ipairs(seq.Keypoints) do
		table.insert(kps, NumberSequenceKeypoint.new(
			pt.Time,
			math.max(0.05, pt.Value * mult),
			pt.Envelope * mult
		))
	end
	return NumberSequence.new(kps)
end

