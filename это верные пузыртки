local function resolveTargetPos(obj)
	if not obj then return nil end
	if obj:IsA("BasePart") then return obj.Position end
	if obj:IsA("Attachment") then
		local ok, cf = pcall(function() return obj.WorldCFrame end)
		if ok and cf then return cf.Position end
	end
	local cur = obj.Parent
	local guard = 0
	while cur and guard < 12 do
		if cur:IsA("BasePart") then return cur.Position end
		if cur:IsA("Attachment") then
			local ok, cf = pcall(function() return cur.WorldCFrame end)
			if ok and cf then return cf.Position end
		end
		if cur:IsA("Model") then
			local hrp = cur:FindFirstChild("HumanoidRootPart") or cur:FindFirstChildWhichIsA("BasePart")
			if hrp then return hrp.Position end
		end
		cur = cur.Parent
		guard += 1
	end
	return nil
end

local function resolveTargetRoot(obj)
	if not obj then return nil end
	if obj:IsA("BasePart") then return obj end
	if obj:IsA("ParticleEmitter") or obj:IsA("Fire") or obj:IsA("Smoke") or obj:IsA("Highlight") or obj:IsA("Attachment") then
		local cur = obj.Parent
		local guard = 0
		while cur and guard < 12 do
			if cur:IsA("BasePart") then return cur end
			if cur:IsA("Model") then
				local hrp = cur:FindFirstChild("HumanoidRootPart") or cur:FindFirstChildWhichIsA("BasePart")
				if hrp then return hrp end
			end
			cur = cur.Parent
			guard += 1
		end
	end
	return nil
end

local function isLikelyOtherPlayerFlame(obj)
	local pos = resolveTargetPos(obj)
	if not pos then return false end

	local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local myDist = myRoot and (pos - myRoot.Position).Magnitude or math.huge

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player and plr.Character then
			local otherRoot = plr.Character:FindFirstChild("HumanoidRootPart")
			if otherRoot then
				local hasActiveFlame = false
				for _, child in ipairs(plr.Character:GetChildren()) do
					if child:IsA("Tool") then
						for _, desc in ipairs(child:GetDescendants()) do
							if desc:IsA("ParticleEmitter") and desc.Name == "Flame" and desc.Enabled then
								hasActiveFlame = true
								break
							end
						end
					end
					if hasActiveFlame then break end
				end

				if hasActiveFlame then
					local deltaOther = pos - otherRoot.Position
					local distOther = deltaOther.Magnitude
					if distOther <= MY_BURN_RANGE then
						if distOther < myDist then
							return true
						end
						if distOther > 1.5 and otherRoot.CFrame.LookVector:Dot(deltaOther.Unit) >= 0.45 then
							return true
						end
					end
				end
			end
		end
	end
	return false
end

local function matchesMyAimAndRange(obj)
	if not isFlameStreamActive() and (os.clock() - lastMyShotTime) > MY_SHOT_WINDOW then
		return false
	end
	if isLikelyOtherPlayerFlame(obj) then
		return false
	end

	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	local pos = resolveTargetPos(obj)
	if not root or not pos then return false end

	local delta = pos - root.Position
	local dist = delta.Magnitude
	if dist > MY_BURN_RANGE then return false end
	if dist < 1.5 then return true end

	local unitDir = delta.Unit
	local look = root.CFrame.LookVector
	local cam = workspace.CurrentCamera
	if cam then
		local camLook = cam.CFrame.LookVector
		local dotLook = look:Dot(unitDir)
		local dotCam  = camLook:Dot(unitDir)
		return math.max(dotLook, dotCam) >= MIN_AIM_DOT
	end

	return look:Dot(unitDir) >= MIN_AIM_DOT
end

local function isBlockedExternalEffect(obj)
	if isAnyToolDescendant(obj) then return true end
	if isLocalPlayerCharacter(obj) then return true end
	return false
end

local function markCharacterBurnedByMe(char)
	if not char or char == player.Character then return end
	myBurnedChars[char] = true
	for _, desc in ipairs(char:GetDescendants()) do
		if desc:IsA("BasePart") or desc:IsA("ParticleEmitter") or desc:IsA("Fire") or desc:IsA("Smoke") or desc:IsA("Highlight") then
			myOwnedBurn[desc] = true
		end
	end
end

local function isOwnedByMe(obj)
	if not obj then return false end
	if isBlockedExternalEffect(obj) then return false end

	if myOwnedBurn[obj] then return true end

	local targetChar = getCharacterFromObj(obj)
	if targetChar and myBurnedChars[targetChar] then
		myOwnedBurn[obj] = true
		return true
	end

	local rootPart = resolveTargetRoot(obj)
	if rootPart and isBlockedExternalEffect(rootPart) then return false end
	if rootPart and myOwnedBurn[rootPart] then
		myOwnedBurn[obj] = true
		if targetChar then myBurnedChars[targetChar] = true end
		return true
	end

	if isMyActiveBurnWindow() and matchesMyAimAndRange(obj) then
		myOwnedBurn[obj] = true
		if rootPart then myOwnedBurn[rootPart] = true end
		if targetChar then markCharacterBurnedByMe(targetChar) end
		return true
	end
	return false
end

local function isBurnEffectName(name)
	local low = string.lower(tostring(name or ""))
	return low == "flamethrowerfireparticle"
		or string.find(low, "flamethrowerfire", 1, true) ~= nil
		or string.find(low, "burn", 1, true) ~= nil
		or string.find(low, "ignite", 1, true) ~= nil
		or string.find(low, "fire", 1, true) ~= nil
		or string.find(low, "flame", 1, true) ~= nil
end

