		return false, ""
	end

	local objs = fetchCreatorStoreAsset(assetUri)
	if not objs then
		return false, "Не удалось загрузить 3D ассет (проверь ID или доступность)."
	end

	local found3DRoot = nil
	for _, src in ipairs(objs) do
		if has3DContent(src) then
			found3DRoot = src
			break
		end
	end

	if not found3DRoot then
		for _, src in ipairs(objs) do pcall(function() src:Destroy() end) end
		return false, "В ассете не найдена 3D-модель / BasePart."
	end

	clearCustom3D()
	customModelActive = true
	selectedModelId = assetUri
	local applied = 0

	for _, tool in ipairs(tools) do
		local anchor = getAnchorPart(tool)
		if anchor then
			for _, part in ipairs(getToolBodyParts(tool)) do
				savePartVisual(part)
				pcall(function() part.Transparency = 1 end)
			end
			local cloned = found3DRoot:Clone()
			local entry = prep3DInstance(cloned, anchor)
			if entry then
				entry.tool = tool
				table.insert(spawned3DModels, entry)
				applied += 1
			end
		end
	end

	for _, src in ipairs(objs) do
		pcall(function() src:Destroy() end)
	end

	if applied == 0 then
		customModelActive = false
		return false, "Не удалось прикрепить 3D модель."
	end
	return true, ("3D модель применена (%d)"):format(applied)
end

-- ============================================================
-- STYLING + TARGETED BURN GUARD
-- ============================================================
local function rememberEmitter(emitter)
	if not original[emitter] then
		original[emitter] = {
			Texture = emitter.Texture,
			Color   = emitter.Color,
			Size    = emitter.Size,
		}
	end
end

local function styleEmitter(emitter, isStream)
	if not emitter or not emitter.Parent or syncingProp then return false end
	if isStream then
		if not isMyEmitter(emitter) then return false end
	else
		if not isOwnedByMe(emitter) then return false end
	end

	rememberEmitter(emitter)
	local data = original[emitter]
	if not data then return false end

	local desiredTexture = selectedTexture
	local desiredColor   = colorSequenceFromSelected()
	local desiredSize    = scaleNumberSequence(data.Size, selectedWidth)

	syncingProp = true
	pcall(function()
		emitter.Texture = desiredTexture
		emitter.Color   = desiredColor
		emitter.Size    = desiredSize
	end)
	syncingProp = false

	if not guardedEmitters[emitter] then
		guardedEmitters[emitter] = true
		pcall(function()
			emitter:GetPropertyChangedSignal("Color"):Connect(function()
				if applyEnabled and not syncingProp and emitter.Parent and (isStream and isMyEmitter(emitter) or (not isStream and isOwnedByMe(emitter))) then
					styleEmitter(emitter, isStream)
				end
			end)
			emitter:GetPropertyChangedSignal("Texture"):Connect(function()
				if applyEnabled and not syncingProp and emitter.Parent and (isStream and isMyEmitter(emitter) or (not isStream and isOwnedByMe(emitter))) then
					styleEmitter(emitter, isStream)
				end
			end)
		end)
	end

	return true
end

local function applyBurnPartColor(part)
	if not part or not part.Parent or not part:IsA("BasePart") or syncingPart then return false end
	if not isOwnedByMe(part) then return false end
	if propOriginal[part] == nil then
		propOriginal[part] = part.Color
	end

	syncingPart = true
	pcall(function()
		if part.Color ~= selectedColor then
			part.Color = selectedColor
		end
	end)
	syncingPart = false

	if not partGuarded[part] then
		partGuarded[part] = true
		pcall(function()
			part:GetPropertyChangedSignal("Color"):Connect(function()
				if applyEnabled and not syncingPart and part.Parent and isOwnedByMe(part) then
					applyBurnPartColor(part)
				end
			end)
		end)
	end

	return true
end

local function applyToBurnFire(fire)
	if not fire or not fire.Parent then return false end
	if not isOwnedByMe(fire) then return false end
	if burnOriginal[fire] == nil then
		burnOriginal[fire] = {
			Color = fire.Color,
			SecondaryColor = fire.SecondaryColor,
			Heat = fire.Heat,
			Size = fire.Size,
		}
	end
	pcall(function()
		fire.Color          = selectedColor
		fire.SecondaryColor = selectedColor
	end)
	return true
end

local function applyToBurnSmoke(smoke)
	if not smoke or not smoke.Parent then return false end
	if not isOwnedByMe(smoke) then return false end
	if smokeOriginal[smoke] == nil then
		smokeOriginal[smoke] = { Color = smoke.Color, Opacity = smoke.Opacity }
	end
	pcall(function() smoke.Color = selectedColor end)
	return true
end

local function applyToBurnHighlight(h)
	if not h or not h.Parent then return false end
	if not isOwnedByMe(h) then return false end
	if highlightOriginal[h] == nil then
		highlightOriginal[h] = { FillColor = h.FillColor, OutlineColor = h.OutlineColor }
	end
	pcall(function()
		h.FillColor    = selectedColor
		h.OutlineColor = selectedColor
	end)
	return true
end

local function processBurnContainer(container)
	if not container or not container.Parent then return false end
	if not isOwnedByMe(container) then return false end
	if container:IsA("BasePart") then
		applyBurnPartColor(container)
	end
	local touched = false
	for _, child in ipairs(container:GetDescendants()) do
		if not isBlockedExternalEffect(child) then
			if child:IsA("ParticleEmitter") and isBurnEffectName(child.Name) then
				myOwnedBurn[child] = true
				styleEmitter(child, false)
				touched = true
			elseif child:IsA("Fire") then
				myOwnedBurn[child] = true
				applyToBurnFire(child)
				touched = true
			elseif child:IsA("Smoke") then
				myOwnedBurn[child] = true
				applyToBurnSmoke(child)
				touched = true
			elseif child:IsA("Highlight") then
				myOwnedBurn[child] = true
				applyToBurnHighlight(child)
				touched = true
			end
		end
	end
	return touched
end

local function routeBurnEffect(effect)
	if not effect or not effect.Parent then return false end
	if not isOwnedByMe(effect) then return false end

	if effect:IsA("Fire") then
		if effect.Parent and effect.Parent:IsA("BasePart") then applyBurnPartColor(effect.Parent) end
		return applyToBurnFire(effect)
	elseif effect:IsA("Smoke") then
		if effect.Parent and effect.Parent:IsA("BasePart") then applyBurnPartColor(effect.Parent) end
		return applyToBurnSmoke(effect)
	elseif effect:IsA("Highlight") then
		return applyToBurnHighlight(effect)
	elseif effect:IsA("ParticleEmitter") then
		if not isBurnEffectName(effect.Name) then return false end
		if effect.Parent and effect.Parent:IsA("BasePart") then applyBurnPartColor(effect.Parent) end
		return styleEmitter(effect, false)
	end
	return false
end

-- ============================================================
-- DAMAGE / HIT DETECTION FOR MY IGNITED TARGETS
-- ============================================================
local function hookCharacterDamage(char)
	if not char or char == player.Character then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hookedHumanoids[hum] then return end
	hookedHumanoids[hum] = true

	local lastHealth = hum.Health
	hum.HealthChanged:Connect(function(newHealth)
		if newHealth < lastHealth and applyEnabled and isMyActiveBurnWindow() then
			local hrp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
			if hrp and matchesMyAimAndRange(hrp) then
				markCharacterBurnedByMe(char)
				processBurnContainer(char)
			end
		end
		lastHealth = newHealth
	end)
end

local function bindAllPlayerCharacters()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			if plr.Character then hookCharacterDamage(plr.Character) end
			plr.CharacterAdded:Connect(function(char)
				hookCharacterDamage(char)
			end)
		end
	end
	Players.PlayerAdded:Connect(function(plr)
		if plr ~= player then
			plr.CharacterAdded:Connect(function(char)
				hookCharacterDamage(char)
			end)
		end
	end)
end

-- ============================================================
-- SPAWN CATCHER
-- ============================================================
local pendingItems = {}
local flushScheduled = false

local function flushPending()
	flushScheduled = false
	if not applyEnabled then
		table.clear(pendingItems)
		return
	end
	for i = 1, #pendingItems do
		local item = pendingItems[i]
		pendingItems[i] = nil
		if item and item.Parent and isOwnedByMe(item) then
			if item:IsA("BasePart") or item:IsA("Model") then
				processBurnContainer(item)
			else
				routeBurnEffect(item)
			end
		end
	end
end

local function enqueueItem(item)
	if not applyEnabled or not item then return end
	if not isOwnedByMe(item) then return end
	table.insert(pendingItems, item)
	if not flushScheduled then
		flushScheduled = true
		RunService.Heartbeat:Once(flushPending)
	end
end

workspace.DescendantAdded:Connect(function(desc)
	if not applyEnabled then return end
	if isBlockedExternalEffect(desc) then return end

	local targetChar = getCharacterFromObj(desc)
	local alreadyMyTarget = (targetChar and myBurnedChars[targetChar]) or myOwnedBurn[desc]
	if not alreadyMyTarget and not isMyActiveBurnWindow() then return end

	if desc:IsA("ParticleEmitter") then
		if isBurnEffectName(desc.Name) then
			enqueueItem(desc)
		end
	elseif desc:IsA("Fire") or desc:IsA("Smoke") or desc:IsA("Highlight") then
		enqueueItem(desc)
	elseif desc:IsA("BasePart") and desc.Name == "Clone" then
		enqueueItem(desc)
	end
end)

-- ============================================================
-- APPLY / RESTORE VISUALS + RESPAWN PERSISTENCE
-- ============================================================
local function applyVisuals(silent)
	applyEnabled = true
	lastMyShotTime = os.clock()

	local emitters = findEmitters()
	local streamCount = 0
	for _, emitter in ipairs(emitters) do
		if styleEmitter(emitter, true) then
			streamCount += 1
		end
	end

	local burnedCount = 0
	for part in pairs(propOriginal) do
		if part and part.Parent and isOwnedByMe(part) and applyBurnPartColor(part) then
			burnedCount += 1
		end
	end
	for emitter in pairs(original) do
		if emitter and emitter.Parent and not isMyEmitter(emitter) and isOwnedByMe(emitter) then
			if styleEmitter(emitter, false) then burnedCount += 1 end
		end
	end
	for fire in pairs(burnOriginal) do
		if fire and fire.Parent and isOwnedByMe(fire) and applyToBurnFire(fire) then burnedCount += 1 end
	end
	for smoke in pairs(smokeOriginal) do
		if smoke and smoke.Parent and isOwnedByMe(smoke) and applyToBurnSmoke(smoke) then burnedCount += 1 end
	end
	for h in pairs(highlightOriginal) do
		if h and h.Parent and isOwnedByMe(h) and applyToBurnHighlight(h) then burnedCount += 1 end
	end

	if customModelActive and selectedModelId ~= "" then
		apply3DModelFromStore(selectedModelId, true)
	end

	if streamCount == 0 and burnedCount == 0 then
		if silent then return false, "" end
		return false, "Flame пока не найден. Экипируй огнемёт."
	end
	return true, ("Струя: %d | Подожжено: %d"):format(streamCount, burnedCount)
end

local function restoreOriginal()
	applyEnabled = false
	selectedModelId = ""
	lastMyShotTime = 0
	table.clear(pendingItems)
	table.clear(myOwnedBurn)
	table.clear(myBurnedChars)
	clearCustom3D()
	local count = 0

	for emitter, data in pairs(original) do
		if emitter and emitter.Parent then
			syncingProp = true
			pcall(function()
				emitter.Texture = data.Texture
				emitter.Color   = data.Color
				emitter.Size    = data.Size
			end)
			syncingProp = false
			count += 1
		end
		original[emitter] = nil
		guardedEmitters[emitter] = nil
	end

	for fire, data in pairs(burnOriginal) do
		if fire and fire.Parent then
			pcall(function()
				fire.Color          = data.Color
				fire.SecondaryColor = data.SecondaryColor
				fire.Heat           = data.Heat
				fire.Size           = data.Size
			end)
		end
		burnOriginal[fire] = nil
	end

	for smoke, data in pairs(smokeOriginal) do
		if smoke and smoke.Parent then
			pcall(function()
				smoke.Color   = data.Color
				smoke.Opacity = data.Opacity
			end)
		end
		smokeOriginal[smoke] = nil
	end

	for part, oldColor in pairs(propOriginal) do
		if part and part.Parent then
			syncingPart = true
			pcall(function() part.Color = oldColor end)
			syncingPart = false
		end
		propOriginal[part] = nil
		partGuarded[part]  = nil
	end

	for h, data in pairs(highlightOriginal) do
		if h and h.Parent then
			pcall(function()
				h.FillColor    = data.FillColor
				h.OutlineColor = data.OutlineColor
			end)
		end
		highlightOriginal[h] = nil
	end

	selectedTexture = DEFAULT_TEXTURE
	selectedColor   = Color3.fromRGB(139, 90, 43)
	selectedWidth   = DEFAULT_WIDTH
	modelScale      = 1.0
	modelOffsetPos  = Vector3.new(0, 0, 0)
	return count
end

local function reapplyAfterRespawn()
	if not applyEnabled and not customModelActive then return end
	task.spawn(function()
		local backpack = player:WaitForChild("Backpack", 10)
		local char = player.Character or player.CharacterAdded:Wait()
		for _ = 1, 20 do
			if #getWeaponRoots() > 0 then break end
			task.wait(0.25)
		end
		if applyEnabled then
			local ok, msg = applyVisuals(true)
			if ok and msg ~= "" and statusLabel then
				statusLabel.Text = "Восстановлено после ресета | " .. msg
				statusLabel.TextColor3 = Color3.fromRGB(135, 235, 170)
			end
		elseif customModelActive and selectedModelId ~= "" then
			apply3DModelFromStore(selectedModelId, true)
		end
		if backpack then
			backpack.ChildAdded:Connect(function(child)
				if child:IsA("Tool") and (applyEnabled or customModelActive) then
					task.wait(0.1)
					if applyEnabled then applyVisuals(true) end
				end
			end)
		end
		if char then
			char.ChildAdded:Connect(function(child)
				if child:IsA("Tool") and (applyEnabled or customModelActive) then
					task.wait(0.1)
					if applyEnabled then applyVisuals(true) end
				end
			end)
		end
	end)
end

player.CharacterAdded:Connect(function()
	table.clear(spawned3DModels)
	customModelActive = (selectedModelId ~= "")
	reapplyAfterRespawn()
end)

-- ============================================================
-- EXECUTOR CONFIG SYSTEM (SAVE / LOAD / DELETE / LIST)
-- ============================================================
local function hasFileSupport()
	return type(writefile) == "function" and type(readfile) == "function"
end

local function ensureConfigFolder()
	if not hasFileSupport() then return false end
	if type(isfolder) == "function" and type(makefolder) == "function" then
		local ok, exists = pcall(isfolder, CONFIG_FOLDER)
		if not ok or not exists then
			pcall(makefolder, CONFIG_FOLDER)
		end
	end
	return true
end

local function sanitizeConfigName(rawName)
	local cleaned = tostring(rawName or "")
		:gsub("^%s+", "")
		:gsub("%s+$", "")
		:gsub("%.json$", "")
		:gsub("[^%w%-%_ ]", "")
	if cleaned == "" then return nil end
	return cleaned
end

local function configFilePath(cfgName)
	return CONFIG_FOLDER .. "/" .. cfgName .. ".json"
end

local function listSavedConfigs()
	local names = {}
	if not ensureConfigFolder() or type(listfiles) ~= "function" then
		return names
	end
	local ok, files = pcall(listfiles, CONFIG_FOLDER)
	if not ok or type(files) ~= "table" then return names end

	for _, fullPath in ipairs(files) do
		local fileName = tostring(fullPath):match("([^/\\]+)$") or tostring(fullPath)
		if fileName:match("%.json$") then
			local cfgName = fileName:gsub("%.json$", "")
			table.insert(names, cfgName)
		end
	end
	table.sort(names)
	return names
end

local function saveConfigToDisk(rawName)
	if not hasFileSupport() then
		return false, "Executor не поддерживает writefile/readfile."
	end
	local cfgName = sanitizeConfigName(rawName)
	if not cfgName then
		return false, "Введи корректное имя конфига."
	end
	ensureConfigFolder()

	local payload = {
		texture = selectedTexture,
		color = {
			r = math.floor(selectedColor.R * 255 + 0.5),
			g = math.floor(selectedColor.G * 255 + 0.5),
			b = math.floor(selectedColor.B * 255 + 0.5),
		},
		width = selectedWidth,
		modelId = selectedModelId,
		scale = modelScale,
		position = {
			x = modelOffsetPos.X,
			y = modelOffsetPos.Y,
			z = modelOffsetPos.Z,
		},
	}

	local okEncode, encoded = pcall(function()
		return HttpService:JSONEncode(payload)
	end)
	if not okEncode or not encoded then
		return false, "Ошибка кодирования JSON."
	end

	local okWrite = pcall(writefile, configFilePath(cfgName), encoded)
	if not okWrite then
		return false, "Не удалось записать файл конфига."
	end

	selectedConfigName = cfgName
	if refreshConfigListUI then refreshConfigListUI() end
	return true, ("Конфиг '%s' сохранён."):format(cfgName)
end

local function loadConfigFromDisk(rawName)
	if not hasFileSupport() then
		return false, "Executor не поддерживает writefile/readfile."
	end
	local cfgName = sanitizeConfigName(rawName)
	if not cfgName then
		return false, "Выбери или введи имя конфига."
	end

	local path = configFilePath(cfgName)
	local okRead, content = pcall(readfile, path)
	if not okRead or not content or content == "" then
		return false, ("Конфиг '%s' не найден."):format(cfgName)
	end

	local okDecode, data = pcall(function()
		return HttpService:JSONDecode(content)
	end)
	if not okDecode or type(data) ~= "table" then
		return false, ("Повреждённый JSON в '%s'."):format(cfgName)
	end

	if type(data.texture) == "string" and data.texture ~= "" then
		selectedTexture = data.texture
	end

	if type(data.color) == "table" then
		local r = tonumber(data.color.r) or 139
		local g = tonumber(data.color.g) or 90
		local b = tonumber(data.color.b) or 43
		selectedColor = Color3.fromRGB(
			math.clamp(math.floor(r), 0, 255),
			math.clamp(math.floor(g), 0, 255),
			math.clamp(math.floor(b), 0, 255)
		)
	end

	if tonumber(data.width) then
		selectedWidth = math.clamp(tonumber(data.width), 0.5, 4.0)
	end

	if type(data.modelId) == "string" then
		selectedModelId = data.modelId
		customModelActive = (selectedModelId ~= "")
	end

	if tonumber(data.scale) then
		modelScale = math.clamp(tonumber(data.scale), 0.2, 5.0)
	end

	if type(data.position) == "table" then
		modelOffsetPos = Vector3.new(
			tonumber(data.position.x) or 0,
			tonumber(data.position.y) or 0,
			tonumber(data.position.z) or 0
		)
	end

	selectedConfigName = cfgName

	if textureInputBox then textureInputBox.Text = selectedTexture end
	if modelIdInputBox then modelIdInputBox.Text = selectedModelId end
	if widthLabel then widthLabel.Text = ("x%.1f"):format(selectedWidth) end
	if scaleLabel then scaleLabel.Text = ("Scale %.1fx"):format(modelScale) end
	if posXBox then posXBox.Text = tostring(modelOffsetPos.X) end
	if posYBox then posYBox.Text = tostring(modelOffsetPos.Y) end
	if posZBox then posZBox.Text = tostring(modelOffsetPos.Z) end
	if setSliderX then setSliderX(modelOffsetPos.X, false) end
	if setSliderY then setSliderY(modelOffsetPos.Y, false) end
	if setSliderZ then setSliderZ(modelOffsetPos.Z, false) end
	if colorPreview then colorPreview.BackgroundColor3 = selectedColor end
	if hexInputBox then
		hexInputBox.Text = string.format("#%02X%02X%02X",
			math.floor(selectedColor.R * 255 + 0.5),
			math.floor(selectedColor.G * 255 + 0.5),
			math.floor(selectedColor.B * 255 + 0.5))
	end

	local okApply, applyMsg = applyVisuals()
	if customModelActive and selectedModelId ~= "" then
		local ok3D, msg3D = apply3DModelFromStore(selectedModelId, false)
		refreshAll3DTransforms()
		if ok3D then
			return true, ("Загружен '%s' | %s"):format(cfgName, msg3D)
		end
	end

	if okApply and applyMsg ~= "" then
		return true, ("Загружен '%s' | %s"):format(cfgName, applyMsg)
	end
	return true, ("Загружен '%s' (настройки применены)."):format(cfgName)
end

local function deleteConfigFromDisk(rawName)
	if type(delfile) ~= "function" then
		return false, "Executor не поддерживает delfile."
	end
	local cfgName = sanitizeConfigName(rawName)
	if not cfgName then
		return false, "Выбери конфиг для удаления."
	end
	local path = configFilePath(cfgName)
	local okDel = pcall(delfile, path)
	if not okDel then
		return false, ("Не удалось удалить '%s'."):format(cfgName)
	end
	if selectedConfigName == cfgName then
		selectedConfigName = ""
	end
	if refreshConfigListUI then refreshConfigListUI() end
	return true, ("Конфиг '%s' удалён."):format(cfgName)
end

-- ============================================================
-- UI + DRAGGABLE + XYZ SLIDERS
-- ============================================================
local function setStatus(message, good)
	if statusLabel and statusLabel.Parent then
		statusLabel.Text = message
		statusLabel.TextColor3 = good and Color3.fromRGB(135, 235, 170)
			or Color3.fromRGB(255, 150, 150)
	end
end

local function make(className, props, parent)
	local obj = Instance.new(className)
	for key, value in pairs(props or {}) do obj[key] = value end
	obj.Parent = parent
	return obj
end

local function round(obj, radius)
	make("UICorner", { CornerRadius = UDim.new(0, radius) }, obj)
end

local function colorToHex(color)
	return string.format("#%02X%02X%02X",
		math.floor(color.R * 255 + 0.5),
		math.floor(color.G * 255 + 0.5),
		math.floor(color.B * 255 + 0.5))
end

local function parseHex(value)
	local hex = tostring(value or ""):gsub("#", "")
	if #hex ~= 6 or not hex:match("^%x%x%x%x%x%x$") then return nil end
	return Color3.fromRGB(
		tonumber(hex:sub(1, 2), 16),
		tonumber(hex:sub(3, 4), 16),
		tonumber(hex:sub(5, 6), 16))
end

local function parseNumber(value, fallback)
	local cleaned = tostring(value or ""):gsub(",", "."):gsub("^%s+", ""):gsub("%s+$", "")
	local n = tonumber(cleaned)
	return n or fallback
end

local function makeDraggable(targetFrame, dragHandle)
	local dragging = false
	local dragInput = nil
	local dragStart = Vector2.zero
	local startPos = UDim2.new()

	dragHandle.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = targetFrame.Position
			dragInput = input

			input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
				end
			end)
		end
	end)

	dragHandle.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			dragInput = input
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if not dragging then return end
		if input == dragInput
			or input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragStart
			targetFrame.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + delta.X,
				startPos.Y.Scale,
				startPos.Y.Offset + delta.Y
			)
		end
	end)
end

local function createAxisSlider(parent, labelText, posY, minVal, maxVal, initialVal, onChanged)
	make("TextLabel", {
		BackgroundTransparency = 1,
		Position = UDim2.fromOffset(15, posY),
		Size = UDim2.fromOffset(22, 20),
		Font = Enum.Font.GothamBold,
		Text = labelText,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(190, 205, 230)
	}, parent)

	local track = make("Frame", {
		Position = UDim2.fromOffset(40, posY + 7),
		Size = UDim2.fromOffset(286, 6),
		BackgroundColor3 = Color3.fromRGB(36, 44, 62),
		BorderSizePixel = 0
	}, parent)
	round(track, 3)

	local fill = make("Frame", {
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.new(0.5, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(85, 130, 215),
		BorderSizePixel = 0
	}, track)
	round(fill, 3)

	local knob = make("TextButton", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = Color3.fromRGB(235, 242, 255),
		Text = "",
		BorderSizePixel = 0,
		AutoButtonColor = false
	}, track)
	round(knob, 7)

	local box = make("TextBox", {
		Position = UDim2.fromOffset(334, posY),
		Size = UDim2.fromOffset(101, 20),
		BackgroundColor3 = Color3.fromRGB(31, 38, 53),
		TextColor3 = Color3.fromRGB(245, 247, 255),
		Text = string.format("%.2f", initialVal),
		ClearTextOnFocus = false,
		Font = Enum.Font.GothamBold,
		TextSize = 10,
		BorderSizePixel = 0
	}, parent)
	round(box, 5)

	local sliding = false

	local function applyRatio(ratio, fireCallback)
		ratio = math.clamp(ratio, 0, 1)
		local rawVal = minVal + (maxVal - minVal) * ratio
		local snapped = math.floor(rawVal * 20 + 0.5) / 20
		local norm = (snapped - minVal) / (maxVal - minVal)
		fill.Size = UDim2.new(norm, 0, 1, 0)
		knob.Position = UDim2.new(norm, 0, 0.5, 0)
		box.Text = string.format("%.2f", snapped)
		if fireCallback and onChanged then
			onChanged(snapped)
		end
	end

	local function setValue(val, fireCallback)
		local clamped = math.clamp(tonumber(val) or 0, minVal, maxVal)
		local norm = (clamped - minVal) / (maxVal - minVal)
		fill.Size = UDim2.new(norm, 0, 1, 0)
		knob.Position = UDim2.new(norm, 0, 0.5, 0)
		box.Text = string.format("%.2f", clamped)
		if fireCallback and onChanged then
			onChanged(clamped)
		end
	end

	local function updateFromScreenX(screenX)
		local absPos = track.AbsolutePosition.X
		local absSize = math.max(1, track.AbsoluteSize.X)
		applyRatio((screenX - absPos) / absSize, true)
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			updateFromScreenX(input.Position.X)
		end
	end)

	knob.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			updateFromScreenX(input.Position.X)
		end
	end)

	box.FocusLost:Connect(function()
		local num = parseNumber(box.Text, initialVal)
		setValue(num, true)
	end)

	setValue(initialVal, false)
	return box, setValue
end

local function refreshPalette()
	if not paletteHolder then return end
	for _, child in ipairs(paletteHolder:GetChildren()) do
		if child:IsA("TextButton") then child:Destroy() end
	end
	for index, color in ipairs(palette) do
		local swatch = make("TextButton", {
			Name = "Color_" .. index,
			Size = UDim2.fromOffset(30, 26),
			BackgroundColor3 = color,
			Text = "",
			BorderSizePixel = 0,
			AutoButtonColor = true,
		}, paletteHolder)
		round(swatch, 6)
		make("UIStroke", {
			Color = Color3.fromRGB(235, 240, 255),
			Transparency = color == selectedColor and 0 or 0.75,
			Thickness = color == selectedColor and 2 or 1
		}, swatch)
		swatch.Activated:Connect(function()
			selectedColor = color
			if colorPreview then colorPreview.BackgroundColor3 = color end
			if hexInputBox then hexInputBox.Text = colorToHex(color) end
			local ok, message = applyVisuals()
			setStatus(message, ok)
			refreshPalette()
		end)
	end
end

local function syncPositionFromBoxes()
	if not posXBox or not posYBox or not posZBox then return end
	local x = parseNumber(posXBox.Text, modelOffsetPos.X)
	local y = parseNumber(posYBox.Text, modelOffsetPos.Y)
	local z = parseNumber(posZBox.Text, modelOffsetPos.Z)
	modelOffsetPos = Vector3.new(x, y, z)
	if setSliderX then setSliderX(x, false) end
	if setSliderY then setSliderY(y, false) end
	if setSliderZ then setSliderZ(z, false) end
	refreshAll3DTransforms()
end

